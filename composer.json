{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nomadicsoft/laravel-indexnow",
    "description": "Production-minded IndexNow notifications for Laravel, with queues, batching, deduplication, multi-host support, and diagnostics.",
    "keywords": [
        "indexnow",
        "laravel",
        "seo",
        "search-engine",
        "yandex"
    ],
    "homepage": "https://github.com/nomadicsoft/laravel-indexnow",
    "license": "MIT",
    "authors": [
        {
            "name": "Nomadic Soft",
            "email": "hello@nomadicsoft.io",
            "homepage": "https://nomadicsoft.io"
        }
    ],
    "support": {
        "issues": "https://github.com/nomadicsoft/laravel-indexnow/issues",
        "security": "https://github.com/nomadicsoft/laravel-indexnow/security/policy",
        "source": "https://github.com/nomadicsoft/laravel-indexnow"
    },
    "require": {
        "php": "^8.2",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "NomadicSoft\\LaravelIndexNow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NomadicSoft\\LaravelIndexNow\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:check": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "NomadicSoft\\LaravelIndexNow\\IndexNowServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
